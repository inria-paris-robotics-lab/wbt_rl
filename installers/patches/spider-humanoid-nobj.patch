index 770b150..eeaf0cc 100644
--- a/spider/postprocess/get_success_rate.py
+++ b/spider/postprocess/get_success_rate.py
@@ -121,9 +121,39 @@ def compute_object_tracking_error(
     qpos_ref: np.ndarray,
     embodiment_type: str,
     data_type: str,
+    num_objects: int = 1,
 ) -> dict:
     """Compute object position/quaternion tracking error for a trajectory."""
     use_act = data_type.endswith("_act")
+    if embodiment_type == "humanoid_nobj":
+        # WBT-RL: N dynamic objects, each a 6-DOF [pos(3), euler(3)] block in the
+        # qpos tail. Report the mean error across objects (the single-object
+        # branch below would silently score only the LAST object).
+        n_obj = max(int(num_objects), 1)
+        n_obj_dof = 6 * n_obj
+        pos_errs, quat_errs, aucs = [], [], []
+        for i in range(n_obj):
+            s = qpos_traj.shape[1] - n_obj_dof + 6 * i
+            pos_t = qpos_traj[:, s : s + 3]
+            pos_r = qpos_ref[:, s : s + 3]
+            quat_t = _euler_to_quat_wxyz(qpos_traj[:, s + 3 : s + 6])
+            quat_r = _euler_to_quat_wxyz(qpos_ref[:, s + 3 : s + 6])
+            pos_errs.append(np.linalg.norm(pos_t - pos_r, axis=1).mean())
+            quat_errs.append(np.linalg.norm(quat_sub(quat_t, quat_r), axis=1).mean())
+            aucs.append(compute_add_auc10(pos_t, pos_r))
+        return {
+            "obj_pos_err": float(np.mean(pos_errs)),
+            "obj_quat_err": float(np.mean(quat_errs)),
+            "pos_err_right": float("nan"),
+            "pos_err_left": float("nan"),
+            "quat_err_right": float("nan"),
+            "quat_err_left": float("nan"),
+            "add_auc10_right": float("nan"),
+            "add_auc10_left": float("nan"),
+            "add_auc10_mean": float(np.mean(aucs)),
+            "per_object_pos_err": [float(e) for e in pos_errs],
+            "per_object_quat_err": [float(e) for e in quat_errs],
+        }
     if embodiment_type == "bimanual":
         if use_act:
             qpos_object_right_traj = qpos_traj[:, -12:-6]
